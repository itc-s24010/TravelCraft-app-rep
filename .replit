modules = ["nodejs-24", "postgresql-16", "java-graalvm22.3", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Spring Boot API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/travel-planner: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Travel Next.js"

[[workflows.workflow]]
name = "Spring Boot API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/spring-api && mvn spring-boot:run -Dspring-boot.run.jvmArguments='-Dserver.port=8099'"
waitForPort = 8099

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Travel Next.js"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/travel-next && node_modules/.bin/next dev -p 3000 -H 0.0.0.0"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SPRING_API_PORT = "8099"
