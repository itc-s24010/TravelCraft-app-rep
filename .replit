modules = ["nodejs-24", "postgresql-16", "java-graalvm22.3", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[[ports]]
localPort = 8081
externalPort = 3001

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Spring Boot API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/travel-next: Next.js Dev Server"

[[workflows.workflow]]
name = "Spring Boot API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/spring-api && mvn spring-boot:run -Dspring-boot.run.jvmArguments='-Dserver.port=8099'"
waitForPort = 8099

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SPRING_API_PORT = "8099"
